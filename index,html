        function downloadAllManifest() {
            const manifestText = documents.map(d => `${d.id}. ${d.title} [${d.filename}.html - ${d.htmlSize} | PDF: ${d.pdfSize}]`).join('\n');
            const blob = new Blob([`JUBILEE INCLUSIVE GREEN CAMPUS - MANIFEST\n\n${manifestText}`], { type: 'text/plain' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'Jubilee_Campus_Manifest.txt';
            a.click();
            URL.revokeObjectURL(url);
        }

