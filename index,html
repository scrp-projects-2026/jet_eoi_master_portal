            activeCategory = cat;
            renderCategoryTabs();
            filterDocuments();
        }

        // Filter and Render Cards
        function filterDocuments() {
            const searchVal = document.getElementById('search-input').value.toLowerCase();
            const sortVal = document.getElementById('sort-select').value;

            let filtered = documents.filter(doc => {
                const matchesCat = activeCategory === "All" || doc.category === activeCategory;
                const matchesSearch = doc.title.toLowerCase().includes(searchVal) || 
                                      doc.filename.toLowerCase().includes(searchVal) ||
                                      doc.desc.toLowerCase().includes(searchVal);
                return matchesCat && matchesSearch;
            });

            // Sorting logic
            if (sortVal === "name-asc") {
                filtered.sort((a, b) => a.title.localeCompare(b.title));
            } else if (sortVal === "size-desc") {
                filtered.sort((a, b) => parseInt(b.htmlSize) - parseInt(a.htmlSize));
            } else if (sortVal === "date-desc") {
                filtered.sort((a, b) => b.date.localeCompare(a.date));
            }

            renderGrid(filtered);
        }

